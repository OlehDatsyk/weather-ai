# ---------------------------------------------------------------------------
# Skyline - AI Weather Assistant
# Copy this file to ".env" and fill in your own values. Never commit ".env".
# ---------------------------------------------------------------------------

# --- Flask ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=9b5e3629028ad5f38898d8e24451c690eb575a7b5615b613
FLASK_DEBUG=true
HOST=127.0.0.1
PORT=1020

# --- Weather provider (OpenWeatherMap) ------------------------------------
# Free key: https://openweathermap.org/api
WEATHER_API_KEY=a805c3b08b8c6b294e7142e589491ac9
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
# metric = Celsius, imperial = Fahrenheit
WEATHER_UNITS=metric

# --- AI provider -----------------------------------------------------------
# Choose ONE provider: "openai" or "anthropic"
AI_PROVIDER=openai

# OpenAI (Responses API) - https://platform.openai.com/api-keys
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4.1

# Anthropic (Messages API) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# AI generation tuning
AI_MAX_TOKENS=900
AI_TEMPERATURE=0.7

# --- App limits --------------------------------------------------------------
MAX_CITIES_COMPARE=4
MAX_HISTORY_MESSAGES=12
